{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,graphql}",
      "**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,graphql}",
      "!**/importMap.js",
      "!payload-types.ts",
      "!**/.specify",
      "!**/.agents"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  }
}
