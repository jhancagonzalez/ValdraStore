# Copia este archivo a .env.local y completa los valores localmente.
# Genera el secreto con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Cadena del pooler de Supabase para la aplicación (no pegar la conexión directa aquí).
DATABASE_URL=

# Conexión directa de Supabase. Solo la usan los comandos de migración Payload.
DATABASE_URL_DIRECT=

# Solo permite crear el primer administrador local mientras no haya uno.
# Se ignora en producción.
ALLOW_ADMIN_BOOTSTRAP=true

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
