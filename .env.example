# Copia este archivo a .env.local y completa los valores localmente.
# Genera el secreto con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Session pooler IPv4 de Supabase (puerto 5432) para la aplicación.
DATABASE_URL=

# Session pooler IPv4 de Supabase para los comandos de migración Payload.
DATABASE_URL_MIGRATIONS=

# Añade a ambas cadenas sslmode=verify-full y sslrootcert con la ruta local
# al certificado raíz descargado desde la configuración SSL de Supabase.

# Mantener en false: ya existe un administrador.
# Solo habilitar temporalmente en desarrollo local si la colección está vacía.
ALLOW_ADMIN_BOOTSTRAP=false

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Credenciales del spike S3 (no son necesarias hasta habilitar el adaptador).
# Se generan en Supabase > Storage > S3 Configuration y solo van en .env.local.
# Tienen acceso privilegiado; no usar NEXT_PUBLIC_ ni subirlas a Git.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=https://pfvhzecrervwtsetspqq.storage.supabase.co/storage/v1/s3
S3_BUCKET=valdra-private-spike
S3_FORCE_PATH_STYLE=true

# URL HTTPS del proyecto Supabase (no es secreto; va solo en servidor).
# Se usa para construir las URLs públicas de las imágenes del catálogo.
SUPABASE_URL=https://pfvhzecrervwtsetspqq.supabase.co

# Bucket público para las imágenes del catálogo (límite 10 MB; JPEG/PNG/WebP).
S3_CATALOG_BUCKET=valdra-catalog-media

# Correo saliente de HU-03 (adaptador SMTP de Payload).
# Proveedor aprobado: Brevo (plan gratuito, 300 correos al día). Solo servidor.
# En Brevo: SMTP y API > SMTP. Host smtp-relay.brevo.com, puerto 587.
# SMTP_USER es el login SMTP que asigna Brevo y SMTP_PASS la clave SMTP,
# no la contraseña de la cuenta. SMTP_FROM_ADDRESS debe ser un remitente verificado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Valdra Store
SMTP_SECURE=false

# Solo desarrollo: captura los correos en una cuenta temporal de Ethereal
# mientras no existan credenciales SMTP reales.
SMTP_USE_ETHEREAL=false

# Cloudflare Workers AI para generar los mockups de personalización.
# Cada integrante crea su cuenta gratuita y genera su propio token.
# No compartir tokens ni usar NEXT_PUBLIC_ para estas variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
